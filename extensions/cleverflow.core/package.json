{
	"name": "@cleverflow/cleverflow.core",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"dist-webcomponents"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./webcomponents/markdoc-editor.js": {
			"import": "./dist-webcomponents/markdoc-editor.js",
			"require": "./dist-webcomponents/markdoc-editor.js"
		},
		"./webcomponents/markdoc-renderer.js": {
			"import": "./dist-webcomponents/markdoc-renderer.js",
			"require": "./dist-webcomponents/markdoc-renderer.js"
		},
		"./webcomponents/markdoc-renderer-controller.js": {
			"import": "./dist-webcomponents/markdoc-renderer-controller.js",
			"require": "./dist-webcomponents/markdoc-renderer-controller.js"
		},
		"./webcomponents/markdoc-reader.js": {
			"import": "./dist-webcomponents/markdoc-reader.js",
			"require": "./dist-webcomponents/markdoc-reader.js"
		},
		"./webcomponents/b-flow.js": {
			"import": "./dist-webcomponents/b-flow.js",
			"require": "./dist-webcomponents/b-flow.js"
		},
		"./webcomponents/b-flow-controller.js": {
			"import": "./dist-webcomponents/b-flow-controller.js",
			"require": "./dist-webcomponents/b-flow-controller.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^3.0.0",
		"@skeletonlabs/skeleton-svelte": "^1.0.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/postcss": "^4.0.11",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@xyflow/svelte": "^0.1.30",
		"lucide-svelte": "^0.475.0",
		"publint": "^0.3.5",
		"shiki": "^3.1.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@cartamd/plugin-component": "^1.1.0",
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"@markdoc/markdoc": "^0.5.1",
		"@nats-io/nats-core": "^3.0.0-51",
		"@types/js-beautify": "^1.14.3",
		"@types/md5": "^2.3.5",
		"@types/postal": "^1.0.35",
		"autoprefixer": "^10.4.20",
		"carta-md": "^4.7.0",
		"isomorphic-dompurify": "^2.22.0",
		"js-yaml": "^4.1.0",
		"lodash": "^4.17.21",
		"md5": "^2.3.0",
		"nats": "^2.29.2",
		"postal": "^2.0.6",
		"postcss": "^8.5.3"
	}
}