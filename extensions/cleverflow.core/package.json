{
	"name": "@cleverflow/cleverflow.core",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"dist-webcomponents"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./webcomponents/markdoc-editor.js": {
			"import": "./dist-webcomponents/markdoc-editor.js",
			"require": "./dist-webcomponents/markdoc-editor.js"
		},
		"./webcomponents/b-flow.js": {
			"import": "./dist-webcomponents/b-flow.js",
			"require": "./dist-webcomponents/b-flow.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.17.1",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.6",
		"publint": "^0.3.5",
		"svelte": "^5.20.0",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.6",
		"typescript": "^5.7.3",
		"vite": "^6.1.0"
	},
	"dependencies": {
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"@nats-io/nats-core": "^3.0.0-51"
	}
}
