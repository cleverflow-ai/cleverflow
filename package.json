{
	"name": "@cleverflow-ai/entire",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"workspaces": [
		"extensions/*",
		"mcp/*",
		"agents/*",
		"clients/*"
	],
	"scripts": {
		"setup": "npm install && npm exec --workspace=extensions/ -- npm install",
		"dev": "vite dev",
  		"build": "npm exec --workspace=extensions/ -- npm run build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^3.1.3",
		"@skeletonlabs/skeleton-svelte": "^1.2.3",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.21.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.11",
		"svelte": "^5.33.14",
		"svelte-check": "^4.2.1",
		"tailwindcss": "^4.0.11",
		"typescript": "^5.7.3",
		"vite": "^6.1.1"
	},
	"dependencies": {
		"@babylonjs/core": "^8.9.0",
		"@babylonjs/loaders": "^8.9.0",
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"@markdoc/markdoc": "^0.5.2",
		"@sjsf/ajv8-validator": "^2.0.0-next.15",
		"@sjsf/basic-theme": "^2.0.0-next.15",
		"@sjsf/form": "^2.0.0-next.15",
		"ajv": "^8.17.1",
		"dotenv-expand": "^12.0.2",
		"dotenv-flow": "^4.1.0",
		"js-yaml": "^4.1.0",
		"lucide-svelte": "^0.512.0",
		"md5": "^2.3.0",
		"postal": "^2.0.6",
		"zod": "^3.25.30"
	}
}
