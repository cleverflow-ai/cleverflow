{
	"name": "@cleverflow-ai/cleverflow.core.frontend",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "ts-node scripts/build-webcomponents.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"dist-webcomponents"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./webcomponents/glb-loader.js": {
			"import": "./dist-webcomponents/glb-loader.js",
			"require": "./dist-webcomponents/glb-loader.js"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^3.0.0",
		"@skeletonlabs/skeleton-svelte": "^1.0.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.0.11",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@xyflow/svelte": "^0.1.31",
		"lucide-svelte": "^0.475.0",
		"publint": "^0.3.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"@markdoc/markdoc": "^0.5.1",
		"@types/js-beautify": "^1.14.3",
		"@types/md5": "^2.3.5",
		"autoprefixer": "^10.4.20",
		"js-yaml": "^4.1.0",
		"lodash": "^4.17.21",
		"md5": "^2.3.0",
		"postcss": "^8.5.3",
		"svelte-pdf": "^1.0.28"
	}
}
